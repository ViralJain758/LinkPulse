PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkpulse
# Required. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Public base URL of the shortener (used to build short links and block self-redirects)
BASE_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy / CDN (nginx, Cloudflare, Render...) so the
# real visitor IP is used. Leave unset when running directly on the internet or locally.
TRUST_PROXY=
# Optional. Secret for hashing visitor IPs. Defaults to JWT_SECRET.
IP_HASH_SECRET=
# Optional. In-memory cache of link lookups for the redirect. Edits and deletes clear it at once
# on the instance that handled them; other instances catch up after the TTL. 0 disables it.
SLUG_CACHE_TTL_SECONDS=60
SLUG_CACHE_MAX=1000
# Optional. SMTP settings for email alerts when a link hits a milestone or is used once.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=
# Optional. What users point a custom domain at (a host name for a CNAME, or an IP).
# Defaults to the host of BASE_URL.
CUSTOM_DOMAIN_TARGET=
# Optional. Google Safe Browsing API key. When set, every destination URL (including routing
# rules and CSV imports) is checked on create/edit and flagged phishing/malware sites are refused.
# Get a key: https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_API_KEY=
SAFE_BROWSING_TIMEOUT_MS=3000
# false (default): if Safe Browsing can't be reached, links are still saved (and the error logged).
# true: links are refused until the check works again.
SAFE_BROWSING_FAIL_CLOSED=false
# Optional. Auth. Access tokens are short-lived; the refresh token renews them (sliding window).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Optional. true = people must confirm their email before they can sign in. Needs SMTP_HOST and a sender.
REQUIRE_EMAIL_VERIFICATION=false
# Optional. Rate limits, shared by all instances through Postgres. 0 turns a limit off.
# Accounts created per IP per hour (each signup sends an email to the address given)
RATE_LIMIT_REGISTER_PER_IP=5
# Login attempts per IP per 15 minutes, across all emails (5 failures per IP+email also lock that pair)
RATE_LIMIT_LOGIN_PER_IP=30
# Links one user can create per hour (each CSV import row counts as one)
RATE_LIMIT_LINKS_PER_USER=500
# Optional. Sender of verification / password-reset emails. Defaults to NOTIFICATION_FROM_EMAIL.
# Reset and confirmation links point at CLIENT_ORIGIN, so set that to the dashboard's public URL.
AUTH_FROM_EMAIL=
